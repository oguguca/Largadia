# Conexão pooled do Neon (usada pela aplicação)
DATABASE_URL=
# Conexão direta do Neon, sem "-pooler" no host (usada pelas migrations)
DIRECT_URL=
# URL pública do site, sem barra no final
NEXT_PUBLIC_SITE_URL=

# Segredo do Auth.js (gere com: npx auth secret)
AUTH_SECRET=

# Admin inicial criado pelo seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (modo de teste: sk_test_...). Nunca commitar a chave secreta.
STRIPE_SECRET_KEY=
# ID do preço (price_...) ou do produto (prod_...) do "Assinante Largadia"
STRIPE_PRICE_ID=
# Gerado pelo "stripe listen" (whsec_...) ou pelo webhook do painel em produção
STRIPE_WEBHOOK_SECRET=
